{
  "name": "carousel-os",
  "version": "1.0.0",
  "description": "Build slide decks with AI agents that you can defend: every number is traced to its source, and a reviewer that didn't build the deck has to pass it. Works in Claude Code, Cursor and Codex.",
  "license": "MIT",
  "author": {
    "name": "Brian Grover",
    "email": "briangrover9@gmail.com",
    "url": "https://www.linkedin.com/in/briantgrover/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briangrover9-hue/carousel-os.git"
  },
  "bugs": {
    "url": "https://github.com/briangrover9-hue/carousel-os/issues"
  },
  "homepage": "https://github.com/briangrover9-hue/carousel-os",
  "keywords": [
    "presentations",
    "powerpoint",
    "pptx",
    "slides",
    "deck",
    "ai-agents",
    "agent-skills",
    "codex",
    "cursor",
    "workflow",
    "claude-code",
    "claim-ledger"
  ],
  "bin": {
    "carousel-os": "scripts/install.js"
  },
  "files": [
    "RULES.md",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "cheatsheet.md",
    "carousel.config.example.json",
    ".agents/",
    "agents/",
    "plans/",
    "memory/handoff.md",
    "memory/handoff.template.md",
    "memory/LOG.template.md",
    "memory/history/",
    "memory/wiki/",
    "bookshelf/",
    "docs/",
    "scripts/",
    "tests/process/",
    "tests/installer/",
    "tests/example/",
    "tests/helpers/",
    "tests/scripts/",
    "!**/.DS_Store",
    "!**/*.carousel-backup*",
    "!**/*.png",
    "!docs/gallery/**",
    "!docs/publish-checklist.md"
  ],
  "scripts": {
    "check": "node scripts/check.js",
    "test": "node tests/process/run.js && node tests/installer/run.js && node tests/scripts/scripts.test.js && node tests/example/scan.test.js",
    "install:process": "node scripts/install.js"
  },
  "engines": {
    "node": ">=20"
  }
}
